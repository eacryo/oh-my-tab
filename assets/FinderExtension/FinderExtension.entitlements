<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Finder Sync app extensions must be sandboxed. The extension deliberately holds no file
         access and no App Group: the menu model arrives over DistributedNotificationCenter and
         every file operation runs in the unsandboxed main app. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
