<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.eacryo.oh-my-tab</string>
    <key>CFBundleName</key>
    <string>Oh-My-Tab</string>
    <key>CFBundleDisplayName</key>
    <string>Oh-My-Tab</string>
    <key>CFBundleExecutable</key>
    <string>oh-my-tab</string>
    <!-- 应用图标(不带扩展名,macOS 自动找 .icns)。由 build-icon.sh 从 icon.svg 生成,打包进 Contents/Resources/。 -->
    <!-- App icon (no extension; macOS appends .icns). Generated from icon.svg by build-icon.sh and bundled into Contents/Resources/. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- SMAppService 要求 macOS 13+;本应用不再兼容 13 以下,直接声明最低系统。 -->
    <!-- SMAppService requires macOS 13+; the app no longer supports below 13, so declare the floor. -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- 辅助应用:无 Dock 图标、无主菜单栏,菜单栏常驻。等价于运行时 setActivationPolicy:1。 -->
    <!-- Accessory app: no Dock icon, no main menu bar, menu-bar resident. Equivalent to runtime setActivationPolicy:1. -->
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
